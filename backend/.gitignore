# ===============================
# Environment Files (SENSITIVE)
# ===============================
.env
.env.*
# Allow committed template — must contain placeholders only
!.env.example

# ===============================
# Docker Compose
# ===============================
# docker-compose.yml is the portable definition anyone can clone and run.
# Local wiring that only makes sense on one machine — attaching an existing
# database or redis container, host port changes — belongs in an override,
# which Compose reads automatically and which must not follow the repo.
docker-compose.override.yml

