# =============================================================================
# SerOps Backend — Environment Template
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All commented-out lines are optional; uncomment and set if you need them.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Django
# -----------------------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3003

# Public URLs used in outbound emails and link generation
API_URL=http://localhost:8000/api
REACT_URL=http://localhost:3003
SERVER_URL=http://localhost:8000/api

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=serops
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# -----------------------------------------------------------------------------
# Celery / Redis
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Batch processing
# -----------------------------------------------------------------------------
BATCH_SCHEDULER_TICK_RATE=1
# BATCH_GENERATION_INTERVAL=15  # fallback if no per-org override

# -----------------------------------------------------------------------------
# AI providers — at least one is required
# -----------------------------------------------------------------------------
# Set whichever providers you plan to use. Per-org API keys can also be
# configured in the UI (Settings → AI) and take precedence over env vars.
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# -----------------------------------------------------------------------------
# Email / SMTP  (env-only — no UI editor, Grafana-style)
# -----------------------------------------------------------------------------
# SerOps sends transactional email (invitation, verification, password
# reset, notifications) through these settings. Change requires
# restarting the backend. Verify with:
#     python manage.py check_smtp <your-address@example.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, switch to the SMTP backend and set the host details:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False   # mutually exclusive with EMAIL_USE_TLS
# DEFAULT_FROM_EMAIL=SerOps <noreply@example.com>

# -----------------------------------------------------------------------------
# Optional integrations — leave unset to disable
# -----------------------------------------------------------------------------
# ELASTICSEARCH_HOST=
# ELASTICSEARCH_PORT=9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_DEFAULT_INDEX=logs-*
# METRICS_ENABLED=false
