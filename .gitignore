# Root-level .gitignore for the SerOps monorepo.
# Per-package ignores live inside backend/, frontend/, docs/.

# Helm dependency artefacts — fetched by `helm dependency update` from
# the bitnami OCI registry at install time. Chart.lock (version pins)
# stays tracked; the downloaded .tgz payloads do not.
deploy/helm/*/charts/*.tgz

# OS + editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
