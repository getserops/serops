# =============================================================================
# SerOps Quick-Start — Environment Template
# =============================================================================
# Copy this file to `.env` and fill in the required values (marked REQUIRED).
# Everything else has a sensible default for local / small-team deployments.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment target
# -----------------------------------------------------------------------------
# Public hostname you'll reach SerOps at (no scheme). Caddy uses this to
# obtain a Let's Encrypt certificate automatically. Leave as "localhost" for
# a pure-local install: Caddy then serves https://localhost with a
# certificate from its own local CA (the browser warns once), which is why
# the URLs below are https:// in both cases.
SEROPS_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Django (REQUIRED)
# -----------------------------------------------------------------------------
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-real-one

DEBUG=False
# ALLOWED_HOSTS must include:
#   - localhost / 127.0.0.1 for health probes
#   - the compose service short name (`backend`) for intra-network HTTP
#   - the container_name (`serops-backend`) for external tools that
#     resolve containers by name (docker exec, adjacent stacks joining
#     the `serops` network — e.g. an OTLP-emitting app in a sibling
#     compose stack). Django enforces RFC 1034/1035, so keep hostnames
#     hyphenated — underscores get rejected as DisallowedHost.
#   - ${SEROPS_DOMAIN} for the public URL clients hit through Caddy
# Add your own container/pod names here if you deploy under different
# naming conventions.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,serops-backend,${SEROPS_DOMAIN}
CORS_ALLOWED_ORIGINS=http://localhost,https://${SEROPS_DOMAIN}

# Whether visitors can create their own organisation from the sign-up
# page (every sign-up creates a NEW organisation; teammates join yours
# through invitations, which always work). Left unset, registration is
# open until your first organisation exists and then closes by itself.
# Set True for an instance hosting several teams, False to keep it
# closed from the start.
# REGISTRATION_ENABLED=

# Public-facing URLs used in outbound emails and link generation.
API_URL=https://${SEROPS_DOMAIN}/api
REACT_URL=https://${SEROPS_DOMAIN}
SERVER_URL=https://${SEROPS_DOMAIN}/api
BASE_URL=https://${SEROPS_DOMAIN}

# -----------------------------------------------------------------------------
# PostgreSQL (REQUIRED)
# -----------------------------------------------------------------------------
POSTGRES_DB=serops
POSTGRES_USER=serops
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-postgres-password

# Mirror the compose network hostname/port so the backend uses the right
# connection details. The compose file also sets these — this block is
# for anyone running the backend outside compose.
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_HOST=postgres
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis (REQUIRED)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 24 — hex on purpose: the password is
# embedded in a redis:// URL, where a '/' (common in base64) breaks parsing.
REDIS_PASSWORD=change-me-strong-redis-password

# -----------------------------------------------------------------------------
# Batch processing
# -----------------------------------------------------------------------------
BATCH_SCHEDULER_TICK_RATE=1
BATCH_GENERATION_INTERVAL=15

# -----------------------------------------------------------------------------
# AI providers — configured in the UI, NOT here
# -----------------------------------------------------------------------------
# SerOps needs at least one AI provider key to analyse anything, but keys
# are NOT read from the environment. Add them after first login at:
#
#   Settings → AI Providers
#
# Supported providers: Anthropic (Claude), Google (Gemini), OpenAI,
# DeepSeek, and Ollama (keyless, on-prem — set the base URL instead).
#
# Why not env vars? On a multi-tenant self-host a shared env-var key
# silently pools quota and billing across every organisation, and the
# onboarding wizard can no longer tell "no key configured yet" apart
# from "key configured but rejected by the provider". Keys are stored
# per-organisation, Fernet-encrypted at rest, in OrganisationAPIKey.
#
# There is no env-var fallback: setting ANTHROPIC_API_KEY here has no
# effect whatsoever.

# -----------------------------------------------------------------------------
# Email / SMTP  (env-only — no UI editor, Grafana-style)
# -----------------------------------------------------------------------------
# Change requires restarting the backend. Verify with:
#   docker compose exec backend python manage.py check_smtp <your-address>
# Defaults to the console backend if unset — invitations print to
# stdout instead of sending. Fine for local dev, useless for prod.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, switch to the SMTP backend and set the host details:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False   # mutually exclusive with EMAIL_USE_TLS
# DEFAULT_FROM_EMAIL=SerOps <noreply@example.com>

# -----------------------------------------------------------------------------
# Observability providers — SerOps consumes these; it does not run them
# -----------------------------------------------------------------------------
# SerOps sits on TOP of the observability stack you already run. There
# is nothing to configure here — connect each provider from
# Settings → Global Integrations in the UI after signing in.
# Supported providers: see https://serops.ai/docs/integrations/overview/
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Version
# -----------------------------------------------------------------------------
# Images are pinned to a release; docker-compose.yml defaults to 1.0.3.
# To upgrade, set the release you want here, then
# `docker compose pull && docker compose up -d` (migrations run on start).
# Releases: https://github.com/getserops/serops/releases
# SEROPS_VERSION=1.0.3

# Only if you mirror the images to your own registry: override the whole
# image reference (this takes precedence over SEROPS_VERSION).
# SEROPS_BACKEND_IMAGE=registry.example.com/serops/backend:1.0.3
# SEROPS_FRONTEND_IMAGE=registry.example.com/serops/frontend:1.0.3
