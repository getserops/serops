# SerOps Caddyfile
#
# Fronts the whole stack on ports 80 + 443. Routes /api and /images to
# the Django backend, everything else to the React frontend. Caddy
# automatically obtains and renews a Let's Encrypt certificate for the
# SEROPS_DOMAIN env var when it is a real public hostname; for
# `localhost` it serves HTTPS with a certificate from its own local CA
# (browsers warn once) and redirects HTTP to it.

{$SEROPS_DOMAIN} {
    # API + Django-served media
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /images/* {
        reverse_proxy backend:8000
    }

    # Everything else = the SPA
    handle {
        reverse_proxy frontend:3000
    }

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
