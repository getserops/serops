# =============================================================================
# SerOps Frontend — Environment Template
# =============================================================================
# Copy this file to `.env`, `.env.development`, or `.env.production`
# and adjust the values for your deployment. Never commit a real `.env`.
# All values are Vite build-time variables, so the bundle must be rebuilt
# after any change.
# =============================================================================

# Public URL of the SerOps backend API (must include the /api prefix).
# Examples:
#   Local dev:  http://localhost:8000/api
#   Production: https://app.your-domain.com/api
VITE_BASE_URL=http://localhost:8000/api

# Port the Vite dev server listens on.
PORT=3003
