# =============================================================================
# SerOps Frontend — Environment Template
# =============================================================================
# Copy this file to `.env`, `.env.development`, or `.env.production`
# and adjust the values for your deployment. Never commit a real `.env`.
# All values are Vite build-time variables, so the bundle must be rebuilt
# after any change.
# =============================================================================

# URL of the SerOps backend API (must include the /api prefix).
# Production: keep the relative `/api` when the app and the API are served
# from the same host (Docker Compose quick start, Helm chart): no CORS setup,
# and the same build works on any domain. Use an absolute URL only when the
# API is on another host, and add the app's origin to the backend's
# CORS_ALLOWED_ORIGINS.
# Examples:
#   Production (same host):  /api
#   Production (API elsewhere): https://api.your-domain.com/api
#   Local dev (Vite + Django):  http://localhost:8000/api
VITE_BASE_URL=http://localhost:8000/api

# Port the Vite dev server listens on.
PORT=3003
